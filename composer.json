{
    "name": "allymailer/allymailer-symfony-bundle",
    "version": "2.0.0",
    "description": "AllyMailer Web API for Symfony: API client services, Symfony Mailer transport, webhooks",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "allymailer",
        "symfony",
        "bundle",
        "mailer",
        "email",
        "webhook"
    ],
    "homepage": "https://github.com/allymailer/allymailer-symfony",
    "require": {
        "php": ">=8.1",
        "allymailer/allymailer-sdk": "^2.0.0",
        "symfony/config": "^6.4|^7.0",
        "symfony/dependency-injection": "^6.4|^7.0",
        "symfony/event-dispatcher": "^6.4|^7.0",
        "symfony/http-foundation": "^6.4|^7.0",
        "symfony/http-kernel": "^6.4|^7.0",
        "symfony/mailer": "^6.4|^7.0",
        "symfony/routing": "^6.4|^7.0"
    },
    "autoload": {
        "psr-4": {
            "AllyMailer\\Wrapper\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
